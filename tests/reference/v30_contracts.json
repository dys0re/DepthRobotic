  "grammar": {
    "put the black bowl on the plate": [
      {
        "action": "pick_place",
        "source": "black bowl",
        "destination": "on plate"
      }
    ],
    "open the top drawer of the cabinet and put the black bowl inside": null,
    "put both the bowl and the mug in the basket": [
      {
        "action": "pick_place",
        "source": "both the bowl and the mug",
        "destination": "in basket"
      }
    ],
    "put the bowl in the cabinet and close it": [
      {
        "action": "pick_place",
        "source": "bowl",
        "destination": "in cabinet"
      },
      {
        "action": "articulate",
        "target": "cabinet",
        "mode": "close"
      }
    ],
    "turn on the stove and put the moka pot on it": [
      {
        "action": "toggle",
        "target": "stove",
        "mode": "on"
      },
      {
        "action": "pick_place",
        "source": "moka pot",
        "destination": "on stove"
      }
    ],
    "stack the bowl on the plate": [
      {
        "action": "pick_place",
        "source": "bowl",
        "destination": "on top of plate"
      }
    ],
    "push the bowl to the right side": [
      {
        "action": "push_object",
        "source": "bowl",
        "destination": "right side"
      }
    ],
    "pick up the bowl and place it on the plate": [
      {
        "action": "pick_place",
        "source": "bowl",
        "destination": "on plate"
      }
    ],
    "rotate the turntable 90 degrees": null
  },
